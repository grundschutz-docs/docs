---
/**
 * Eingabefeld "Welcher alte Baustein?" fuer die Startseite.
 *
 * Springt zur Vergleichsseite des Bausteins, in jeder Schreibweise (OPS.1.1.5,
 * ops 1.1.5, ops115). Dieselbe Normalisierung wie der Direktsprung im
 * Suchdialog (Search.astro) und der Filter auf /vergleich/. Bausteine ohne
 * Zuordnung im BSI-Mapping fuehren auf die Erklaerung dazu statt ins Leere.
 *
 * Daten aus src/data/bausteine.json (Generator), nur auf dieser Seite
 * eingebettet.
 */
import bausteine from '../data/bausteine.json';
import { Icon } from '@astrojs/starlight/components';

const data = JSON.stringify(bausteine.map((b) => [b.id, b.title, b.slug]));
---

<form class="baustein-sprung" role="search" aria-label="Alten Baustein suchen" data-bausteine={data}>
	<label class="baustein-sprung-label" for="baustein-sprung-input">Alte Baustein-ID</label>
	<div class="baustein-sprung-field">
		<Icon class="baustein-sprung-icon" name="magnifier" />
		<input
			id="baustein-sprung-input"
			type="search"
			autocomplete="off"
			autocapitalize="characters"
			spellcheck="false"
			placeholder="z. B. OPS.1.1.5 oder INF 2"
		/>
	</div>
	<p class="baustein-sprung-hit" aria-live="polite" hidden>
		<a href="/vergleich/"></a>
		<span></span>
	</p>
</form>

<script>
	const form = document.querySelector<HTMLFormElement>('.baustein-sprung');
	const input = form?.querySelector<HTMLInputElement>('input');
	const hit = form?.querySelector<HTMLElement>('.baustein-sprung-hit');
	const link = hit?.querySelector<HTMLAnchorElement>('a');
	const note = hit?.querySelector<HTMLElement>('span');
	if (form && input && hit && link && note) {
		const normalize = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
		const byId = new Map(
			(JSON.parse(form.dataset.bausteine ?? '[]') as [string, string, string][]).map((b) => [
				normalize(b[0]),
				b,
			]),
		);
		// Ziel und Text zu einer Eingabe; undefined = kein Baustein.
		const lookup = () => {
			const q = normalize(input.value);
			const b = /\d/.test(q) ? byId.get(q) : undefined;
			if (!b) return undefined;
			return {
				href: b[2] ? `/vergleich/${b[2]}/` : '/vergleich/#ohne-zuordnung',
				text: `${b[0]} ${b[1]}`,
				note: b[2] ? '' : 'Keine Zuordnung im BSI-Mapping, Erklärung ansehen',
			};
		};
		input.addEventListener('input', () => {
			const found = lookup();
			hit.hidden = !found;
			if (found) {
				link.href = found.href;
				link.textContent = found.text;
				note.textContent = found.note;
			}
		});
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const found = lookup();
			if (found) {
				window.location.href = found.href;
			} else if (input.value.trim()) {
				hit.hidden = false;
				link.href = '/vergleich/';
				link.textContent = 'Alle Bausteine ansehen';
				note.textContent = `Keinen Baustein „${input.value.trim()}“ gefunden.`;
			}
		});
	}
</script>

<style>
	.baustein-sprung {
		margin-top: 0.75rem;
	}
	.baustein-sprung-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.baustein-sprung-field {
		position: relative;
	}
	.baustein-sprung-icon {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 1rem;
		transform: translateY(-50%);
		width: 1.1rem;
		height: 1.1rem;
		color: var(--sl-color-gray-3);
		pointer-events: none;
	}
	input {
		width: 100%;
		padding: 0.65rem 1.1rem 0.65rem 2.75rem;
		border-radius: 999px;
		border: 1px solid var(--glass-border);
		background-color: var(--glass-tint);
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
	}
	input:focus-visible {
		outline: none;
		border-color: var(--sl-color-accent);
	}
	.baustein-sprung-hit {
		margin: 0.75rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.baustein-sprung-hit[hidden] {
		display: none;
	}
	.baustein-sprung-hit a {
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.baustein-sprung-hit span {
		display: block;
		color: var(--sl-color-gray-3);
	}
</style>
