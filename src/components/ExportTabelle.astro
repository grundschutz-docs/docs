---
// Filter und Download für die Exportseite. Die Daten kommen aus
// public/downloads/grundschutzpp-anforderungen.json (vom Generator geschrieben,
// täglich mit dem Katalog abgeglichen). Das Markup der Filter entsteht beim Bauen
// aus genau dieser Datei, der Browser lädt sie danach nur noch zum Filtern nach.
// Nur Markup + Script hier drin, die CSS-Regeln liegen global in custom.css
// (gleiches Muster wie VergleichFilter.astro).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const data = JSON.parse(
	readFileSync(join(process.cwd(), 'public', 'downloads', 'grundschutzpp-anforderungen.json'), 'utf-8'),
);
type Row = { id: string; praktik_id: string; zielobjekte: string[]; unterkategorien: string[] };
const rows: Row[] = data.anforderungen;

const NO_TARGET = 'Ohne Zielobjektkategorie';

// Zählen statt von Hand pflegen: Praktiken und Zielobjekte stehen so immer mit
// der Zahl da, die im Katalog wirklich dahintersteht.
const countByPraktik = new Map<string, number>();
const countByTarget = new Map<string, number>();
for (const r of rows) {
	countByPraktik.set(r.praktik_id, (countByPraktik.get(r.praktik_id) ?? 0) + 1);
	// Eine Anforderung gilt für ihre direkte Kategorie und für alle darunter (STM.2.1.4.1):
	// die Zahl hinter einer Kategorie ist, was man bei Auswahl dieser Kategorie bekommt.
	for (const t of new Set([...r.zielobjekte, ...r.unterkategorien])) countByTarget.set(t, (countByTarget.get(t) ?? 0) + 1);
}
const praktiken: { id: string; titel: string }[] = data.praktiken;
const targets = [...countByTarget.keys()].filter((t) => t !== NO_TARGET).sort((a, b) => a.localeCompare(b, 'de'));
const noTargetCount = countByTarget.get(NO_TARGET) ?? 0;

const EFFORT = ['0', '1', '2', '3', '4', '5'];
---

<div id="export-tool" data-no-target={NO_TARGET}>
	{/* Meldung, wenn der Link etwas nennt, das es nicht (mehr) gibt (z. B. eine umbenannte Kategorie):
	    Sonst zeigt die Seite still alle Anforderungen (ADR-0013). Steht oben, weil man per Link hierher kommt. */}
	<p id="export-query-warning" class="export-warning" role="status" hidden></p>
	<form class="export-form" aria-label="Anforderungen für den Export auswählen">
		<fieldset class="export-group">
			<legend>Praktik</legend>
			<div class="export-options export-options-wide">
				{
					praktiken.map((p) => (
						<label>
							<input type="checkbox" name="praktik" value={p.id} />
							{p.id} {p.titel} <span class="export-count">({countByPraktik.get(p.id)})</span>
						</label>
					))
				}
			</div>
		</fieldset>

		<fieldset class="export-group">
			<legend>Pflichtgrad</legend>
			<div class="export-options">
				<label><input type="checkbox" name="pflicht" value="MUSS" /> MUSS</label>
				<label><input type="checkbox" name="pflicht" value="SOLLTE" /> SOLLTE</label>
				<label><input type="checkbox" name="pflicht" value="KANN" /> KANN</label>
			</div>
		</fieldset>

		<fieldset class="export-group">
			<legend>Sicherheitsstufe</legend>
			<div class="export-options">
				<label><input type="checkbox" name="stufe" value="Standard-Sicherheitsstufe" /> Standard-Sicherheitsstufe</label>
				<label><input type="checkbox" name="stufe" value="Erhöhte Sicherheitsstufe" /> Erhöhte Sicherheitsstufe</label>
			</div>
		</fieldset>

		<fieldset class="export-group">
			<legend>Aufwand</legend>
			<div class="export-options">
				{EFFORT.map((e) => <label><input type="checkbox" name="aufwand" value={e} /> {e}</label>)}
			</div>
			<p class="export-hint">0 = nicht bewertet, 1 = Quick Win, 5 = aufwändig und komplex (Skala des BSI).</p>
		</fieldset>

		<fieldset class="export-group">
			<legend>Zielobjektkategorie</legend>
			<details>
				<summary>Kategorien auswählen (<span id="export-target-selected">keine</span>)</summary>
				<div class="export-options export-options-wide">
					{
						targets.map((t) => (
							<label>
								<input type="checkbox" name="ziel" value={t} />
								{t} <span class="export-count">({countByTarget.get(t)})</span>
							</label>
						))
					}
				</div>
			</details>
			<p class="export-hint">
				Wählst du eine Kategorie, bekommst du auch die Anforderungen ihrer Oberkategorien: Der Katalog verlangt, dass
				ein Asset die übergeordneten Kategorien erbt (STM.2.1.4.1). Für „Webserver“ gelten also auch die
				Anforderungen für „Anwendungen“. Die Zahl hinter einer Kategorie enthält diese geerbten Anforderungen.
			</p>
			<label class="export-include">
				<input type="checkbox" id="export-include-no-target" checked />
				Auch Anforderungen ohne Zielobjektkategorie ({noTargetCount})
			</label>
			<p class="export-hint">
				Nach dem BSI-Standard 300-1 (3.4.1) gehören diese Anforderungen in jedes Anforderungspaket,
				unabhängig davon, welche Assets es gibt. Das Häkchen nur entfernen, wenn du sie bewusst
				ausblenden willst.
			</p>
		</fieldset>
	</form>

	<div class="export-result">
		{/* Nur der Zähler ist live. Als ganze Region würde Hilfstechnik bei jeder Änderung
		    den Bereich samt allen Knöpfen vorlesen. */}
		<p class="export-summary" role="status" aria-live="polite"><strong id="export-count">Lade Daten …</strong></p>
		<p class="export-actions">
			<button type="button" id="export-xlsx" class="export-button" disabled>
				Excel-Datei herunterladen (.xlsx)
			</button>
			<button type="button" id="export-download" class="export-button export-button-secondary" disabled>
				CSV herunterladen
			</button>
			<button type="button" id="export-reset" class="export-reset">Auswahl zurücksetzen</button>
		</p>
		<p class="export-actions export-share">
			<button type="button" id="export-copy-link" class="export-button export-button-secondary">
				Link zu dieser Auswahl kopieren
			</button>
			<button type="button" id="export-copy-md" class="export-button export-button-secondary" disabled>
				Checkliste als Markdown kopieren
			</button>
			<button type="button" id="export-copy-rich" class="export-button export-button-secondary" disabled>
				Checkliste formatiert kopieren
			</button>
			<button type="button" id="export-save-md" class="export-button export-button-secondary" disabled>
				Checkliste als .md speichern
			</button>
		</p>
		<p id="export-share-status" class="export-share-status" role="status" aria-live="polite"></p>
		<p class="export-hint">
			Die Checkliste enthält je Anforderung die ID (als Link auf die Seite mit dem Text), den Titel und den Pflichtgrad,
			dazu die Dokumente, die sie nennen, und die Quelle. Den Volltext lässt sie weg, damit sie in einem Ticket
			lesbar bleibt. „Markdown“ ist reiner Text, zum Beispiel für GitHub-Issues. „Formatiert“ legt zusätzlich eine
			formatierte Liste mit Links ab, für Editoren, die formatierten Text einfügen können (zum Beispiel Jira,
			Confluence, Word oder E-Mail). Was dein Editor daraus macht, hängt von ihm ab.
		</p>
		<p id="export-error" class="gf-filter-empty" hidden>
			Die Filter konnten nicht geladen werden. Die fertigen Dateien weiter unten funktionieren trotzdem.
		</p>
	</div>
</div>

{/* Fertige Dateien als normale Links: funktionieren auch ohne JavaScript und
    für alle, die einfach "alles" oder eine ganze Praktik wollen. */}
<h2 id="fertige-dateien">Fertige Dateien zum Download</h2>
<p>
	Datenstand des Katalogs: {data.stand}. Die Dateien werden täglich mit dem Katalog des BSI abgeglichen.
</p>
<ul class="export-files">
	<li>
		<a href="/downloads/grundschutzpp-anforderungen.csv" download>
			<strong>Alle {rows.length} Anforderungen</strong>
		</a>
		(CSV)
	</li>
	{
		praktiken.map((p) => (
			<li>
				<a href={`/downloads/grundschutzpp-anforderungen-${p.id.toLowerCase()}.csv`} download>
					{p.id} {p.titel}
				</a>{' '}
				({countByPraktik.get(p.id)})
			</li>
		))
	}
</ul>

<script>
	import { GROUPS, buildQuery, parseQuery, unknownMessage, type Group, type QueryState } from '../lib/export-query';
	import { copyToClipboard } from '../lib/export-clipboard';
	import { toHtml, toMarkdown, type ChecklistContext } from '../lib/export-checkliste';

	type Row = {
		id: string;
		titel: string;
		praktik_id: string;
		praktik: string;
		anforderung: string;
		pflichtgrad: string;
		stufe: string;
		aufwand: string;
		zielobjekte: string[];
		unterkategorien: string[];
		ergebnis: string;
		dokument: string;
		gefaehrdungen: string[];
		vorgaenger: string[];
		seite: string;
	};
	type Payload = { quelle: string; arbeitsspalten: string[]; spalten: string[]; anforderungen: Row[] };
	const XLSX_MIME = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';

	const root = document.getElementById('export-tool') as HTMLElement;
	const NO_TARGET = root.dataset.noTarget ?? '';
	const form = root.querySelector('form') as HTMLFormElement;
	const countEl = document.getElementById('export-count') as HTMLElement;
	const downloadBtn = document.getElementById('export-download') as HTMLButtonElement;
	const xlsxBtn = document.getElementById('export-xlsx') as HTMLButtonElement;
	const resetBtn = document.getElementById('export-reset') as HTMLButtonElement;
	const errorEl = document.getElementById('export-error') as HTMLElement;
	const includeNoTarget = document.getElementById('export-include-no-target') as HTMLInputElement;
	const targetSelected = document.getElementById('export-target-selected') as HTMLElement;
	const warningEl = document.getElementById('export-query-warning') as HTMLElement;
	const copyLinkBtn = document.getElementById('export-copy-link') as HTMLButtonElement;
	const shareStatus = document.getElementById('export-share-status') as HTMLElement;
	const copyMdBtn = document.getElementById('export-copy-md') as HTMLButtonElement;
	const copyRichBtn = document.getElementById('export-copy-rich') as HTMLButtonElement;
	const saveMdBtn = document.getElementById('export-save-md') as HTMLButtonElement;

	type FullPayload = Payload & { stand: string; praktiken: { id: string; titel: string }[]; dokumente: unknown[]; lizenz: Record<string, string> };
	let payload: FullPayload | null = null;

	function checked(name: string): Set<string> {
		const boxes = form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`);
		return new Set(Array.from(boxes, (b) => b.value));
	}

	// Nichts angehakt heißt "keine Einschränkung", nicht "nichts auswählen".
	function select(rows: Row[]): Row[] {
		const praktik = checked('praktik');
		const pflicht = checked('pflicht');
		const stufe = checked('stufe');
		const aufwand = checked('aufwand');
		const ziel = checked('ziel');
		return rows.filter((r) => {
			if (praktik.size && !praktik.has(r.praktik_id)) return false;
			if (pflicht.size && !pflicht.has(r.pflichtgrad)) return false;
			if (stufe.size && !stufe.has(r.stufe)) return false;
			if (aufwand.size && !aufwand.has(r.aufwand)) return false;
			if (ziel.size) {
				const ohne = r.zielobjekte.length === 1 && r.zielobjekte[0] === NO_TARGET;
				const gilt = [...r.zielobjekte, ...r.unterkategorien];
				const trifft = gilt.some((t) => ziel.has(t));
				if (!(trifft || (ohne && includeNoTarget.checked))) return false;
			}
			return true;
		});
	}

	// Gleiche Regeln wie csv.writer im Generator: Semikolon als Trenner, Zellen mit
	// Semikolon, Anführungszeichen oder Zeilenumbruch in Anführungszeichen,
	// Zeilenende CRLF, UTF-8 mit BOM. Deutsches Excel braucht beides.
	function cell(value: string): string {
		return /[;"\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
	}

	// Jede Spalte findet ihren Wert über ihren Namen aus payload.spalten. Früher standen die
	// Werte an festen Positionen: kam im Generator eine Spalte dazu, verschob sich still alles.
	// Eine Spalte ohne Eintrag hier ist jetzt ein Fehler statt einer falschen Datei.
	const VALUE: Record<string, (r: Row) => string> = {
		'ID': (r) => r.id,
		'Titel': (r) => r.titel,
		'Praktik': (r) => r.praktik,
		'Anforderung': (r) => r.anforderung,
		'Pflichtgrad': (r) => r.pflichtgrad,
		'Sicherheitsstufe': (r) => r.stufe,
		'Aufwand': (r) => r.aufwand,
		'Zielobjektkategorien': (r) => r.zielobjekte.join('; '),
		'Gilt auch für Unterkategorien': (r) => r.unterkategorien.join('; '),
		'Ergebnis': (r) => r.ergebnis,
		'Dokumentiert in': (r) => r.dokument,
		'Gefährdungen': (r) => r.gefaehrdungen.join('; '),
		'Vorgänger im Kompendium 2023': (r) => r.vorgaenger.join('; '),
		'Seite': (r) => r.seite,
	};

	function toCsv(rows: Row[], p: Payload): string {
		const head = [...p.spalten, ...p.arbeitsspalten, 'Quelle'];
		const getters = p.spalten.map((name) => {
			const get = VALUE[name];
			if (!get) throw new Error(`Spalte "${name}" ist im Browser-Export nicht bekannt`);
			return get;
		});
		const lines = [head.map(cell).join(';')];
		for (const r of rows) {
			const line = [...getters.map((get) => get(r)), ...p.arbeitsspalten.map(() => ''), p.quelle];
			lines.push(line.map(cell).join(';'));
		}
		return '﻿' + lines.join('\r\n') + '\r\n';
	}

	function update() {
		const ziel = checked('ziel').size;
		targetSelected.textContent = ziel ? `${ziel} gewählt` : 'keine';
		if (!payload) return;
		const n = select(payload.anforderungen).length;
		const total = payload.anforderungen.length;
		countEl.textContent = n === total ? `Alle ${total} Anforderungen` : `${n} von ${total} Anforderungen ausgewählt`;
		downloadBtn.disabled = n === 0;
		xlsxBtn.disabled = n === 0;
		for (const b of [copyMdBtn, copyRichBtn, saveMdBtn]) b.disabled = n === 0;
		if (n === 0) countEl.textContent = 'Keine Anforderung passt zu dieser Auswahl';
	}

	// Die Auswahl als Adresse (ADR-0013). Gelesen wird z. B. /export/?praktik=GC,STM (so verlinken die
	// Praktik-Seiten) oder /export/?ziel=Webserver,Cloud-Dienste&ohne=nein. Geschrieben wird bei jeder Aenderung,
	// damit "Link kopieren" und die Adressleiste dieselbe Auswahl zeigen.
	function validValues(): Record<Group, Set<string>> {
		const valid = {} as Record<Group, Set<string>>;
		for (const g of GROUPS) {
			valid[g] = new Set(Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${g}"]`), (b) => b.value));
		}
		return valid;
	}

	function currentState(): QueryState {
		const selected = {} as Record<Group, string[]>;
		for (const g of GROUPS) selected[g] = [...checked(g)];
		return { selected, ohne: includeNoTarget.checked };
	}

	function applyQuery() {
		const { state, unknown } = parseQuery(location.search, validValues());
		for (const g of GROUPS) {
			form.querySelectorAll<HTMLInputElement>(`input[name="${g}"]`).forEach((b) => {
				b.checked = state.selected[g].includes(b.value);
			});
		}
		includeNoTarget.checked = state.ohne;
		// Ein Wert, den es nicht gibt, darf nicht still wie "keine Einschraenkung" wirken: sichtbar melden.
		const message = unknownMessage(unknown, state);
		warningEl.textContent = message;
		warningEl.hidden = !message;
	}

	function writeQuery() {
		history.replaceState(null, '', location.pathname + buildQuery(currentState()) + location.hash);
	}

	function save(blob: Blob, filename: string) {
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = filename;
		document.body.appendChild(a);
		a.click();
		a.remove();
		URL.revokeObjectURL(url);
	}

	// Die Auswahl in Worten, für das Info-Blatt der Excel-Datei: wer die Datei später
	// öffnet, sieht, welche Filter zu dieser Auswahl gehörten.
	function describeSelection(): string {
		const parts: string[] = [];
		const add = (label: string, set: Set<string>) => set.size && parts.push(`${label}: ${[...set].join(', ')}`);
		add('Praktik', checked('praktik'));
		add('Pflichtgrad', checked('pflicht'));
		add('Sicherheitsstufe', checked('stufe'));
		add('Aufwand', checked('aufwand'));
		const ziel = checked('ziel');
		if (ziel.size) {
			parts.push(`Zielobjekt: ${[...ziel].join(', ')} (mit Oberkategorien${includeNoTarget.checked ? ', und ohne Zielobjektkategorie' : ''})`);
		}
		return parts.join('; ');
	}

	downloadBtn.addEventListener('click', () => {
		if (!payload) return;
		const rows = select(payload.anforderungen);
		save(new Blob([toCsv(rows, payload)], { type: 'text/csv;charset=utf-8' }), 'grundschutzpp-anforderungen-auswahl.csv');
	});

	// Die Excel-Erzeugung wird erst beim Klick geladen: Wer nur liest, lädt sie nicht.
	xlsxBtn.addEventListener('click', async () => {
		if (!payload) return;
		const label = xlsxBtn.textContent;
		xlsxBtn.disabled = true;
		xlsxBtn.textContent = 'Datei wird erzeugt …';
		errorEl.hidden = true;
		try {
			const { buildExportWorkbook } = await import('../lib/xlsx/export-workbook.js');
			const bytes = buildExportWorkbook(payload, select(payload.anforderungen), {
				filterText: describeSelection(),
				now: new Date(),
			});
			save(new Blob([bytes], { type: XLSX_MIME }), 'grundschutzpp-anforderungen-auswahl.xlsx');
		} catch (err) {
			console.error(err);
			errorEl.textContent = 'Die Excel-Datei konnte nicht erzeugt werden. Die CSV-Datei funktioniert trotzdem.';
			errorEl.hidden = false;
		} finally {
			xlsxBtn.textContent = label;
			update();
		}
	});

	resetBtn.addEventListener('click', () => {
		form.reset();
		includeNoTarget.checked = true;
		warningEl.hidden = true;
		update();
		writeQuery();
	});

	form.addEventListener('change', () => {
		// Wer die Auswahl aendert, hat den Link hinter sich gelassen: die Meldung galt dem alten Link.
		warningEl.hidden = true;
		update();
		writeQuery();
	});

	let statusTimer: number | undefined;
	function say(message: string) {
		shareStatus.textContent = message;
		window.clearTimeout(statusTimer);
		statusTimer = window.setTimeout(() => (shareStatus.textContent = ''), 6000);
	}

	copyLinkBtn.addEventListener('click', async () => {
		writeQuery();
		const result = await copyToClipboard(location.href);
		say(result === 'failed' ? 'Kopieren nicht möglich. Die Adresse in der Adressleiste ist der Link.' : 'Link kopiert.');
	});

	// Die Checkliste (ADR-0013). Der Link darin zeigt auf die oeffentliche Adresse der Seite, nicht auf die
	// Adresse, unter der man gerade sitzt: Wer die Liste weitergibt, will, dass der Empfaenger sie oeffnen kann.
	function checklist(): { rows: Row[]; ctx: ChecklistContext } | null {
		if (!payload) return null;
		const rows = select(payload.anforderungen);
		if (!rows.length) return null;
		const siteUrl = new URL(rows[0].seite).origin;
		return {
			rows,
			ctx: {
				auswahl: describeSelection(),
				link: `${siteUrl}/export/${buildQuery(currentState())}`,
				stand: payload.stand,
				quelle: payload.quelle,
				praktiken: payload.praktiken,
				siteUrl,
			},
		};
	}

	copyMdBtn.addEventListener('click', async () => {
		const c = checklist();
		if (!c) return;
		const result = await copyToClipboard(toMarkdown(c.rows, c.ctx));
		say(
			result === 'failed'
				? 'Kopieren nicht möglich. Nutze „Checkliste als .md speichern“.'
				: `Markdown kopiert (${c.rows.length} Anforderungen).`,
		);
	});

	copyRichBtn.addEventListener('click', async () => {
		const c = checklist();
		if (!c) return;
		const result = await copyToClipboard(toMarkdown(c.rows, c.ctx), toHtml(c.rows, c.ctx));
		say(
			result === 'rich'
				? `Formatiert kopiert (${c.rows.length} Anforderungen), mit dem Markdown-Text als Zweitformat. Dein Editor wählt beim Einfügen.`
				: result === 'failed'
					? 'Kopieren nicht möglich. Nutze „Checkliste als .md speichern“.'
					: `Nur als Text kopiert (${c.rows.length} Anforderungen): Dein Browser kann kein formatiertes Kopieren.`,
		);
	});

	saveMdBtn.addEventListener('click', () => {
		const c = checklist();
		if (!c) return;
		save(new Blob([toMarkdown(c.rows, c.ctx)], { type: 'text/markdown;charset=utf-8' }), 'grundschutzpp-anforderungspaket.md');
	});
	applyQuery();
	update();

	fetch('/downloads/grundschutzpp-anforderungen.json')
		.then((res) => {
			if (!res.ok) throw new Error(String(res.status));
			return res.json() as Promise<Payload>;
		})
		.then((json) => {
			payload = json;
			update();
		})
		.catch(() => {
			countEl.textContent = 'Filter nicht verfügbar';
			errorEl.hidden = false;
		});
</script>
