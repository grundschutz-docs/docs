---
// ID-Check: Wer eine Liste eigener Anforderungs-IDs hat, sieht hier, welche davon das BSI seit einem
// Datum geändert hat. Die Eingabe bleibt im Browser: Es gibt nur einen Abruf (die Änderungsdaten,
// /aenderungen/ids.json), und der enthält nichts von den Nutzenden. Nichts wird gespeichert.
// Das Ergebnis bewertet nichts; es sagt nur "geändert", "nicht geändert" oder "nicht im Katalog".
// Die Regeln stehen in src/lib/id-check.ts, die Daten in src/pages/aenderungen/ids.json.ts.
---

<section class="idc not-content" id="id-check" aria-labelledby="idc-titel" data-pagefind-ignore>
	<form class="idc-form" novalidate>
		<div class="idc-feld">
			<label for="idc-ids" id="idc-titel">Deine Anforderungs-IDs</label>
			<textarea id="idc-ids" name="ids" rows="7" wrap="off" spellcheck="false" autocomplete="off" aria-describedby="idc-hilfe-ids idc-erkannt" placeholder={'GC.1.1\nBES.7.4.12\nDET.2.3'}></textarea>
			<p class="idc-erkannt" id="idc-erkannt" role="status" aria-live="polite"></p>
			<p class="idc-hilfe" id="idc-hilfe-ids">
				Eine ID pro Zeile, oder einen Text oder eine Tabelle einfügen: Die IDs werden darin gefunden. Mit den Spalten „ID“ und „Bewertet am“ (wie im Excel-Export dieser Seite) wird jede Zeile ab ihrem eigenen Datum geprüft.
			</p>
		</div>
		<div class="idc-zeile">
			<div class="idc-feld idc-datum">
				<label for="idc-seit">Änderungen seit</label>
				<input type="date" id="idc-seit" name="seit" aria-describedby="idc-hilfe-seit" />
				<p class="idc-hilfe" id="idc-hilfe-seit">Ab diesem Tag einschließlich, zum Beispiel das Datum deiner letzten Bewertung. Hat deine Tabelle eine Spalte „Bewertet am“, gilt dort das Datum der jeweiligen Zeile.</p>
			</div>
			<div class="idc-feld">
				<label for="idc-datei">Oder eine Datei laden</label>
				<input type="file" id="idc-datei" accept=".csv,.txt,.tsv,.md,text/plain,text/csv" aria-describedby="idc-hilfe-datei" />
				<p class="idc-hilfe" id="idc-hilfe-datei">CSV oder Text, wird nur in deinem Browser gelesen. Excel-Dateien (.xlsx) kann der Check nicht lesen: speichere sie als CSV oder kopiere die Spalten „ID“ und „Bewertet am“ hierher.</p>
				<p class="idc-datei-meldung" id="idc-datei-meldung" role="status" aria-live="polite"></p>
			</div>
		</div>
		<div class="idc-aktionen">
			<button type="submit" class="idc-knopf">Änderungen prüfen</button>
			<button type="button" class="idc-knopf idc-knopf-leise" id="idc-leeren">Leeren</button>
		</div>
	</form>

	<div class="idc-ergebnis" id="idc-ergebnis" role="status" aria-live="polite" tabindex="-1"></div>
	<noscript><p>Für den ID-Check braucht dein Browser JavaScript. Das <a href="/aenderungen/">Änderungsprotokoll</a> funktioniert auch ohne.</p></noscript>
</section>

<script>
	import { parseEingabe, pruefe, datumDe, beschreibeEingabe, type IdDaten, type Ergebnis } from '../lib/id-check';

	const form = document.querySelector<HTMLFormElement>('.idc-form')!;
	const ids = document.querySelector<HTMLTextAreaElement>('#idc-ids')!;
	const seit = document.querySelector<HTMLInputElement>('#idc-seit')!;
	const datei = document.querySelector<HTMLInputElement>('#idc-datei')!;
	const leeren = document.querySelector<HTMLButtonElement>('#idc-leeren')!;
	const ausgabe = document.querySelector<HTMLElement>('#idc-ergebnis')!;
	const erkannt = document.querySelector<HTMLElement>('#idc-erkannt')!;
	const dateiMeldung = document.querySelector<HTMLElement>('#idc-datei-meldung')!;

	// Zeigt, was aus der Eingabe gelesen wird, bevor man prüft (bei Tippen, Einfügen und Laden einer Datei).
	const zeigeErkanntes = () => {
		erkannt.textContent = ids.value.trim() ? beschreibeEingabe(parseEingabe(ids.value)) : '';
	};
	ids.addEventListener('input', zeigeErkanntes);
	const MAX_BYTES = 2 * 1024 * 1024;

	const el = <K extends keyof HTMLElementTagNameMap>(tag: K, klasse?: string, text?: string) => {
		const e = document.createElement(tag);
		if (klasse) e.className = klasse;
		if (text !== undefined) e.textContent = text;
		return e;
	};

	let daten: Promise<IdDaten> | undefined;
	// Erst beim ersten Prüfen laden, nicht beim Öffnen der Seite.
	const lade = () =>
		(daten ??= fetch('/aenderungen/ids.json').then((r) => {
			if (!r.ok) throw new Error(String(r.status));
			return r.json() as Promise<IdDaten>;
		}));

	const katalogLink = (id: string, praktik: string) => {
		const a = el('a', 'idc-id', id);
		a.href = `/grundschutzpp/${praktik.toLowerCase()}/#${id}`;
		return a;
	};

	function zeige(ergebnisse: Ergebnis[], d: IdDaten, ab: string, ungueltig: number) {
		ausgabe.replaceChildren();
		const zahl = (art: Ergebnis['art']) => ergebnisse.filter((x) => x.art === art).length;
		const geaendert = zahl('geaendert') + zahl('neu') + zahl('entfernt');
		const kopf = el('p', 'idc-summe');
		kopf.append(
			`${ergebnisse.length} ${ergebnisse.length === 1 ? 'ID' : 'IDs'} geprüft, Änderungen ${
				ergebnisse.some((x) => x.eigenesDatum) ? 'seit dem jeweiligen Bewertungsdatum' : `seit ${datumDe(ab)}`
			}: `,
			Object.assign(el('strong'), { textContent: `${geaendert} geändert, ${zahl('unveraendert')} nicht geändert` }),
			zahl('unbekannt') ? `, ${zahl('unbekannt')} nicht im Katalog.` : '.',
		);
		ausgabe.append(kopf);
		if (ungueltig) {
			ausgabe.append(
				el(
					'p',
					'idc-hinweis',
					`${ungueltig} ${ungueltig === 1 ? 'Datum konnte' : 'Daten konnten'} nicht gelesen werden und ${ungueltig === 1 ? 'wurde' : 'wurden'} durch das allgemeine Datum ersetzt. Erlaubt sind TT.MM.JJJJ und JJJJ-MM-TT.`,
				),
			);
		}

		const praktikVon = (id: string) => d.aenderungen[id]?.[0]?.praktik ?? id.split('.')[0];
		const liste = el('ul', 'idc-liste');
		// Unveränderte stehen getrennt: sind es viele, klappen sie ein, damit die Treffer oben nicht untergehen.
		const ruhig = el('ul', 'idc-liste');
		const reihenfolge = { geaendert: 0, neu: 1, entfernt: 2, unbekannt: 3, unveraendert: 4 } as const;
		[...ergebnisse].sort((a, b) => reihenfolge[a.art] - reihenfolge[b.art]).forEach((x) => {
			const li = el('li', `idc-eintrag idc-${x.art}`);
			const id = x.art === 'unbekannt' ? el('span', 'idc-id', x.id) : katalogLink(x.id, praktikVon(x.id));
			const status = el('span', 'idc-status');
			if (x.art === 'geaendert') {
				status.textContent =
					(x.aenderungen.length === 1 ? 'Geändert' : `${x.aenderungen.length}-mal geändert`) +
					(x.eigenesDatum ? ` seit deiner Bewertung am ${datumDe(x.ab)}` : '');
				li.append(id, status);
				const titel = el('span', 'idc-titel', x.aenderungen[0].titel);
				li.append(titel);
				const einzel = el('ul', 'idc-einzel');
				x.aenderungen.forEach((a) => {
					const zeile = el('li');
					const link = el('a', undefined, datumDe(a.datum));
					link.href = `/aenderungen/#stand-${a.commit}`;
					zeile.append(link, `: ${a.felder.join(', ')}`);
					einzel.append(zeile);
				});
				li.append(einzel);
			} else {
				status.textContent =
					x.art === 'neu'
						? `Neu im Katalog seit ${datumDe(x.seit.datum)}`
						: x.art === 'entfernt'
							? `Entfernt am ${datumDe(x.seit.datum)}`
							: x.art === 'unbekannt'
								? 'Nicht im Katalog'
								: x.eigenesDatum
									? `Nicht geändert seit deiner Bewertung am ${datumDe(x.ab)}`
									: 'Nicht geändert';
				li.append(id, status);
			}
			(x.art === 'unveraendert' ? ruhig : liste).append(li);
		});
		if (liste.childElementCount) ausgabe.append(liste);
		if (ruhig.childElementCount) {
			if (ruhig.childElementCount > 8) {
				const details = el('details', 'idc-ruhig');
				const n = ruhig.childElementCount;
				details.append(el('summary', undefined, `${n} Anforderungen ohne Änderung anzeigen`), ruhig);
				ausgabe.append(details);
			} else {
				ausgabe.append(ruhig);
			}
		}

		const fuss = el('p', 'idc-fuss');
		fuss.append(
			`Stand der Daten: BSI-Commit ${d.stand.commit.slice(0, 7)} vom ${datumDe(d.stand.veroeffentlicht.slice(0, 10))}. Erfasst sind Änderungen seit dem ${datumDe(d.beginn)}. `,
			Object.assign(el('a'), { href: '/aenderungen/', textContent: 'Alle Änderungen im Wortlaut' }),
			'. Die Liste sagt nur, was sich geändert hat, nicht, ob es für dich relevant ist.',
		);
		ausgabe.append(fuss);
	}

	function melde(text: string) {
		ausgabe.replaceChildren(el('p', 'idc-hinweis', text));
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const eingabe = parseEingabe(ids.value);
		const eingegeben = eingabe.eintraege;
		if (!eingegeben.length) return melde('Keine Anforderungs-IDs gefunden. Eine ID sieht zum Beispiel so aus: GC.5.1.1.');
		let d: IdDaten;
		try {
			d = await lade();
		} catch {
			daten = undefined;
			return melde('Die Änderungsdaten konnten nicht geladen werden. Bitte später noch einmal versuchen.');
		}
		const ab = seit.value || d.beginn;
		zeige(pruefe(d, eingegeben, ab), d, ab, eingabe.ungueltigeDaten);
		ausgabe.focus();
	});

	datei.addEventListener('change', async () => {
		const f = datei.files?.[0];
		if (!f) return;
		datei.value = '';
		if (/\.(xlsx|xlsm|xls|ods)$/i.test(f.name)) {
			dateiMeldung.textContent = `${f.name}: Excel-Dateien kann der Check nicht lesen. Speichere sie als CSV (Trennzeichen Semikolon) oder kopiere die Spalten „ID“ und „Bewertet am“ hierher.`;
			return;
		}
		if (f.size > MAX_BYTES) {
			dateiMeldung.textContent = `${f.name}: Die Datei ist größer als 2 MB. Eine Liste mit Anforderungs-IDs ist viel kleiner, vielleicht ist es die falsche Datei.`;
			return;
		}
		ids.value = await f.text();
		const zeilen = ids.value.split(/\r?\n/).filter((z) => z.trim()).length;
		dateiMeldung.textContent = `Geladen: ${f.name} (${zeilen} ${zeilen === 1 ? 'Zeile' : 'Zeilen'}).`;
		zeigeErkanntes();
	});

	leeren.addEventListener('click', () => {
		ids.value = '';
		erkannt.textContent = '';
		dateiMeldung.textContent = '';
		seit.value = '';
		ausgabe.replaceChildren();
		ids.focus();
	});
</script>

<style is:global>
	/* global, weil die Ergebnisliste per Skript entsteht und Astros Scope-Attribut nicht trägt; alle Klassen beginnen mit idc- */
	.idc {
		margin: 0 0 2rem;
	}
	.idc-form {
		display: grid;
		gap: 1.1rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background-color: var(--sl-color-bg-nav);
	}
	.idc-zeile {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1.1rem;
	}
	.idc-feld {
		display: grid;
		gap: 0.35rem;
		align-content: start;
	}
	.idc label {
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.idc textarea,
	.idc input[type='date'] {
		width: 100%;
		box-sizing: border-box;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg);
		color: var(--sl-color-text);
		font: inherit;
	}
	.idc textarea {
		/* wrap="off": eine eingefügte Tabellenzeile bleibt eine Zeile (seitlich scrollbar), statt zu einem Block umzubrechen */
		overflow-x: auto;
		font-family: var(--sl-font-mono);
		/* 16 px: iOS zoomt beim Antippen von Feldern mit kleinerer Schrift ins Bild */
		font-size: 1rem;
		resize: vertical;
	}
	.idc :is(textarea, input, button):focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.idc input[type='file'] {
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		max-width: 100%;
	}
	.idc input[type='file']::file-selector-button {
		margin-right: 0.75rem;
		padding: 0.55rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-text);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.idc-erkannt,
	.idc-datei-meldung {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.idc-erkannt:empty,
	.idc-datei-meldung:empty {
		display: none;
	}
	.idc-hilfe {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.idc-aktionen {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.idc-knopf {
		padding: 0.55rem 1.1rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background-color: var(--sl-color-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.idc-knopf-leise {
		background: transparent;
		color: var(--sl-color-text);
		border-color: var(--sl-color-gray-5);
	}
	.idc-ergebnis {
		margin-top: 1.5rem;
		/* Kopfleiste und Banner liegen fest am oberen Rand (zusammen bis 132 px): ein angesprungenes Ergebnis darf nicht darunter landen. */
		scroll-margin-top: 9rem;
	}
	.idc-ergebnis:focus {
		outline: none;
	}
	.idc-summe {
		margin: 0 0 0.8rem;
	}
	.idc-liste,
	.idc-einzel {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.idc-eintrag {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.8rem;
		padding: 0;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.idc-id {
		font-family: var(--sl-font-mono);
		font-weight: 600;
		display: inline-block;
		padding-block: 0.6rem;
	}
	.idc-ergebnis a {
		color: var(--sl-color-text-accent);
	}
	.idc-eintrag > * {
		margin: 0;
	}
	.idc-status {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.idc-geaendert .idc-status,
	.idc-neu .idc-status,
	.idc-entfernt .idc-status {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	.idc-titel {
		flex-basis: 100%;
		font-size: var(--sl-text-sm);
	}
	.idc-einzel {
		flex-basis: 100%;
		padding-bottom: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.idc-ruhig {
		margin-top: 0.4rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.idc-ruhig > summary {
		cursor: pointer;
		padding: 0.7rem 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.idc-fuss,
	.idc-hinweis {
		margin: 1rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
