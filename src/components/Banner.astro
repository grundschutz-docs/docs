---
/**
 * Sitewide Status-Leiste.
 *
 * Inhalt kommt aus src/data/status.json (Generator, write_status_data) statt
 * aus festem Text. Vorher stand hier "Grundschutz++ ist aktuell in der
 * Pilotphase (bis 30.9.2026)" — ab dem 1.10.2026 also falsch, auf jeder Seite,
 * und im Widerspruch zur eigenen Zeitleiste unter /grundschutzpp/zeitplan/,
 * die ihre laufende Phase aus dem Datum ableitet. Auf einer Seite, deren Thema
 * Fristen und Gültigkeitszeiträume sind, ist ein abgelaufenes Datum im
 * Dauer-Banner der teuerste Fehler überhaupt.
 *
 * Beides liest jetzt dieselbe TIMELINE in scripts/generate_docs.py.
 */
import status from '../data/status.json';
//
// Die Quick-Nav-Zweitzeile (ADR-0006) ist ausgezogen in eine eigene
// Header.astro-Überschreibung (siehe dort) -- Banner ist für die temporäre
// Pilotphase-Statusmeldung gedacht, permanente Navigation gehört semantisch
// nicht in eine als "vorübergehende Meldung" wirkende Leiste. Korrektur von
// ADR-0006, siehe dessen Changelog.
---

<div class="sl-banner" data-pagefind-ignore>
	{/* Punkt statt Gedankenstrich: der Detailsatz kommt aus TIMELINE und ist
	    dort ein eigener, großgeschriebener Satz — hinter einem Gedankenstrich
	    läse er sich holprig. */}
	<span
		>Grundschutz++ ist in der <strong>{status.phase}</strong>{status.bis && ` (bis ${status.bis})`}.
		{' '}{status.detail}</span
	>
	<a href="/grundschutzpp/zeitplan/">Zum Zeitplan</a>
</div>

<script>
	// --banner-height stand vorher als geratener fester Wert in custom.css
	// (3.5rem / 2.5rem je Breakpoint) -- auf schmalen Bildschirmen bricht der
	// Banner-Text aber auf drei Zeilen um (beobachtet: Samsung Galaxy S25
	// Ultra, Samsung Internet), und dann stimmte die Rate nicht mehr. Starlights
	// eigene MobileTableOfContents.astro positioniert sich u.a. relativ dazu
	// (siehe dortige Ueberschreibung) -- eine falsche Rate dort heisst
	// sichtbare Ueberlappung, kein nur leicht falscher Abstand.
	// ResizeObserver statt nur "resize"-Event: reagiert auch auf
	// Schriftart-Nachladen, Zoom und Orientierungswechsel, ohne die noetig
	// zu unterscheiden.
	const banner = document.querySelector<HTMLElement>('.sl-banner');
	if (banner) {
		const setHeight = () => {
			document.documentElement.style.setProperty('--banner-height', `${banner.offsetHeight}px`);
		};
		setHeight();
		new ResizeObserver(setHeight).observe(banner);
	}
</script>

<style>
	@layer starlight.core {
		.sl-banner {
			padding-inline: calc(var(--sl-nav-pad-x) + var(--sl-menu-button-size));
			padding-block: 0.4rem;
			background-color: var(--banner-tint);
			color: var(--sl-color-text);
			line-height: 1.3;
			text-align: center;
			text-wrap: balance;
			font-size: var(--sl-text-xs);
			border-bottom: 1px solid var(--sl-color-accent);
		}
		.sl-banner a {
			display: inline-block;
			margin-inline-start: 0.5em;
			color: var(--sl-color-accent-high);
			font-weight: 600;
			white-space: nowrap;
		}
	}
</style>
