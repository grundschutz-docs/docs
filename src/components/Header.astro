---
// Überschreibt Starlights eigene Header.astro (gleicher Mechanismus wie
// ThemeSelect/Hero/Footer/Banner/SocialIcons -- kein Sonderfall). Grund:
// die Quick-Nav-Links (Übersicht/Vergleich/Rollen) gehören permanent in
// den Header, nicht ins Banner, das für die temporäre Pilotphase-Meldung
// gedacht ist -- Korrektur von ADR-0006, siehe dessen Changelog.
//
// Bewusst NICHT das grid-template-columns von Starlights Original
// angefasst -- die Formel dort richtet die Titel-Spalte exakt an der
// Sidebar-Kante aus (siehe Kommentar im Original). Die Nav-Links stehen
// stattdessen zusätzlich in der bestehenden mittleren "Suche"-Zelle, die
// die Suche selbst nicht voll ausfüllt (reiner Such-Button, keine
// Vollbreite-Eingabe).
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden middle-group">
		{shouldRenderSearch && <Search />}
		{/*
		  Vier Einträge sind die Obergrenze, nicht sieben: Titel (~180px),
		  Quicknav und Icons (~130px) teilen sich bei 800px etwa 728px, der
		  Rest gehört dem Suchfeld. Sieben Einträge brauchten allein ~486px und
		  liessen nichts übrig -- mit white-space: nowrap wird daraus kein enger
		  Header, sondern ein überlaufender. Wer hier etwas ergänzt, nimmt an
		  anderer Stelle Platz weg.
		*/}
		<nav class="quicknav sl-hidden md:sl-flex" aria-label="Schnellzugriff">
			<a href="/grundschutzpp/">Übersicht</a>
			<a href="/vergleich/">Vergleich</a>
			{/* Steht bei Übersicht und Vergleich, nicht bei den Rollen: alle drei
			    sind Sichten auf den Katalog, die Rollen dahinter sind Einstiege
			    für Personen. Und Befunde ist das, was diese Seite von einer
			    reinen Aufbereitung unterscheidet — das gehört nicht hinter eine
			    Sidebar-Gruppe versteckt. */}
			<a href="/befunde/">Befunde</a>
			{/* Die Rollen standen hier und sind bewusst raus: sie sind dreifach
			    vorhanden -- als drei große Karten auf der Startseite ("Wer bist
			    du?"), als eigene Sidebar-Gruppe, und hier. Die Karten holen
			    einen Erstbesucher besser ab als ein 4mm-Link, und wer
			    wiederkommt, will in den Katalog, nicht in seine Rolle. */}
			{/* Autorität der Quelle ist für ein Compliance-Publikum die erste
			    Frage, noch vor dem Inhalt: offizielles BSI-Angebot oder privates
			    Projekt, das sich nur so nennt? Die Antwort stand bisher nur im
			    Schlussabsatz der Startseite und im Footer -- also nicht dort, wo
			    jemand sie sucht. Bewusst am Ende der Gruppe: wichtig genug für
			    die Kopfleiste, aber kein Einstieg wie die Rollen. */}
			<a href="/ueber/">Über</a>
		</nav>
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.middle-group {
			flex-grow: 1;
			align-items: center;
			gap: 1.5rem;
			min-width: 0;
		}

		.quicknav {
			align-items: center;
			gap: 1.1rem;
			font-size: var(--sl-text-xs);
			white-space: nowrap;
		}

		.quicknav a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
			font-weight: 600;
		}

		.quicknav a:hover {
			color: var(--sl-color-accent-high);
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					1fr
					auto;
				align-content: center;
			}
		}
	}
</style>
