---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const isEnglish = Astro.currentLocale === 'en';
const legalPrefix = isEnglish ? '/en' : '';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />
	{/* Vier Spalten mit Überschrift statt einer Linkzeile: Grundschutz++, Projekt,
	    Entwickler, Rechtliches. Die Kopfleiste ist mobil knapp (das GitHub-Symbol sitzt dort
	    in einer Gruppe, die erst ab mittlerer Breite erscheint), der Footer ist
	    auf jeder Seite und jedem Gerät da. */}
	<div class="footer-columns">
		<nav aria-labelledby="footer-gspp">
			<p class="col-title" id="footer-gspp">Grundschutz++</p>
			<a href="/grundschutzpp/">{isEnglish ? 'Catalog (German)' : 'Katalog'}</a>
			<a href={`${legalPrefix}/methodik/`}>{isEnglish ? 'Methodology' : 'Methodik'}</a>
			<a href="/grundschutzpp/zeitplan/">{isEnglish ? 'Status & timeline (German)' : 'Status & Zeitplan'}</a>
			<a href="/aenderungen/">{isEnglish ? 'Catalog changes (German)' : 'Änderungen am Katalog'}</a>
			<a href="/vergleich/">{isEnglish ? 'Old ↔ new (German)' : 'Alt ↔ Neu'}</a>
			<a href="/zielobjekte/">{isEnglish ? 'Target object categories (German)' : 'Zielobjekte'}</a>
			<a href="/dokumente/">{isEnglish ? 'Documents (German)' : 'Dokumente'}</a>
		</nav>
		<nav aria-labelledby="footer-project">
			<p class="col-title" id="footer-project">{isEnglish ? 'Project' : 'Projekt'}</p>
			<a href={`${legalPrefix}/ueber/`}>{isEnglish ? 'About this site' : 'Über diese Seite'}</a>
			<a href={`${legalPrefix}/befunde/`}>{isEnglish ? 'Findings' : 'Befunde'}</a>
		</nav>
		<nav aria-labelledby="footer-tools">
			<p class="col-title" id="footer-tools">{isEnglish ? 'Data & tools' : 'Daten & Werkzeuge'}</p>
			<a href="/export/">{isEnglish ? 'Export for Excel (German)' : 'Export für Excel'}</a>
			<a href={`${legalPrefix}/rag/`}>{isEnglish ? 'Catalog as data (RAG)' : 'Katalog als Daten (RAG)'}</a>
			<a href="https://github.com/grundschutz-docs/docs">{isEnglish ? 'Source code on GitHub' : 'Quellcode auf GitHub'}</a>
			<a href="https://github.com/BSI-Bund/Stand-der-Technik-Bibliothek">{isEnglish ? 'BSI original catalog' : 'BSI-Originalkatalog'}</a>
		</nav>
		<nav aria-labelledby="footer-legal">
			<p class="col-title" id="footer-legal">{isEnglish ? 'Legal' : 'Rechtliches'}</p>
			<a href={`${legalPrefix}/impressum/`}>{isEnglish ? 'Legal Notice' : 'Impressum'}</a>
			<a href={`${legalPrefix}/datenschutz/`}>{isEnglish ? 'Privacy Policy' : 'Datenschutz'}</a>
		</nav>
	</div>
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}
		.footer-columns {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 2rem 1.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-hairline);
		}
		.footer-columns nav {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
			font-size: var(--sl-text-sm);
		}
		.col-title {
			margin: 0 0 0.2rem;
			font-size: var(--sl-text-xs);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--sl-color-gray-2);
		}
		.footer-columns a {
			color: var(--sl-color-gray-3);
			text-decoration: none;
		}
		.footer-columns a:hover {
			color: var(--sl-color-accent);
		}
		@media (max-width: 40rem) {
			.footer-columns {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
	}
</style>
