---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import ZuletztGeaendert from './ZuletztGeaendert.astro';
import Kurzlink from './Kurzlink.astro';

const isEnglish = Astro.currentLocale === 'en';
const legalPrefix = isEnglish ? '/en' : '';
// Auf der Methodik-Seite steht eine Zusammenfassung des Standards 300-1, der nicht unter
// CC BY-SA steht, sondern unter den Nutzungsbedingungen des BSI. Dort gilt die zweite Zeile.
const path = Astro.url.pathname.replace(/^\/en(?=\/)/, '');
const isMethodik = path === '/methodik' || path === '/methodik/';
const BSI_TERMS = 'https://www.bsi.bund.de/DE/Service/Nutzungsbedingungen/Nutzungsbedingungen_node.html';
const CC_BY_SA = 'https://creativecommons.org/licenses/by-sa/4.0/';
const BSI_CATALOG = 'https://github.com/BSI-Bund/Stand-der-Technik-Bibliothek';
---

<ZuletztGeaendert />
<Kurzlink />
<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />
	{/* Vier Spalten, nach der Frage geordnet, mit der man kommt: Nachschlagen (nach Praktik, nach
	    System, nach Dokument, vom alten Kompendium aus), Verstehen (Methodik, Zeitplan, was sich
	    ändert, Befunde), Daten & Werkzeuge, Projekt (mit Impressum und Datenschutz). Die Kopfleiste ist mobil knapp
	    (das GitHub-Symbol sitzt dort in einer Gruppe, die erst ab mittlerer Breite erscheint),
	    der Footer ist auf jeder Seite und jedem Gerät da. Impressum und Datenschutz tragen ihren
	    Namen als Linktext und stehen auf jeder Seite. */}
	<div class="footer-columns">
		<nav aria-labelledby="footer-lookup">
			<p class="col-title" id="footer-lookup">{isEnglish ? 'Look things up' : 'Nachschlagen'}</p>
			<a href="/grundschutzpp/">{isEnglish ? 'Catalog by practice (German)' : 'Katalog nach Praktik'}</a>
			<a href="/zielobjekte/">{isEnglish ? 'By target object (German)' : 'Nach Zielobjekt'}</a>
			<a href="/dokumente/">{isEnglish ? 'By document (German)' : 'Nach Dokument'}</a>
			<a href="/gefaehrdungen/">{isEnglish ? 'By threat (German)' : 'Nach Gefährdung'}</a>
			<a href="/vergleich/">{isEnglish ? 'From the old Kompendium (German)' : 'Vom alten Kompendium'}</a>
		</nav>
		<nav aria-labelledby="footer-understand">
			<p class="col-title" id="footer-understand">{isEnglish ? 'Understand' : 'Verstehen'}</p>
			<a href={`${legalPrefix}/methodik/`}>{isEnglish ? 'Methodology' : 'Methodik'}</a>
			<a href="/grundschutzpp/zeitplan/">{isEnglish ? 'Status & timeline (German)' : 'Status & Zeitplan'}</a>
			<a href="/aenderungen/">{isEnglish ? 'Catalog changes (German)' : 'Änderungen am Katalog'}</a>
			<a href={`${legalPrefix}/befunde/`}>{isEnglish ? 'Findings' : 'Befunde'}</a>
			{isEnglish && <a href="/en/operating-in-germany/">If your company operates in Germany</a>}
		</nav>
		<nav aria-labelledby="footer-tools">
			<p class="col-title" id="footer-tools">{isEnglish ? 'Data & tools' : 'Daten & Werkzeuge'}</p>
			<a href="/export/">{isEnglish ? 'Export for Excel, with a sheet for your own values (German)' : 'Export für Excel, mit Festlegungsblatt'}</a>
			<a href="/id-check/">{isEnglish ? 'ID check: have my requirements changed? (German)' : 'ID-Check: Haben sich meine IDs geändert?'}</a>
			<a href={isEnglish ? '/en/ueber/#linking-to-and-citing-requirements' : '/ueber/#anforderungen-verlinken-und-zitieren'}>{isEnglish ? 'Short links and citing' : 'Kurzlinks und Zitieren'}</a>
			<a href={`${legalPrefix}/rag/`}>{isEnglish ? 'Catalog as data (RAG)' : 'Katalog als Daten (RAG)'}</a>
			<a href="/aenderungen/#abonnieren">{isEnglish ? 'Subscribe: catalog changes (German, RSS)' : 'Abonnieren: Katalogänderungen (RSS)'}</a>
			<a href={`${legalPrefix}/befunde/#abonnieren`}>{isEnglish ? 'Subscribe: findings (German, RSS)' : 'Abonnieren: Befunde (RSS)'}</a>
			<a href="https://github.com/grundschutz-docs/docs">{isEnglish ? 'Source code on GitHub' : 'Quellcode auf GitHub'}</a>
			<a href="https://github.com/BSI-Bund/Stand-der-Technik-Bibliothek">{isEnglish ? 'BSI original catalog' : 'BSI-Originalkatalog'}</a>
		</nav>
		<nav aria-labelledby="footer-project">
			<p class="col-title" id="footer-project">{isEnglish ? 'Project' : 'Projekt'}</p>
			<a href={`${legalPrefix}/ueber/`}>{isEnglish ? 'About this site' : 'Über diese Seite'}</a>
			<a href={`${legalPrefix}/grenzen/`}>{isEnglish ? 'What this site is, and is not' : 'Was diese Seite ist – und was nicht'}</a>
			<a href={`${legalPrefix}/impressum/`}>{isEnglish ? 'Legal Notice' : 'Impressum'}</a>
			<a href={`${legalPrefix}/datenschutz/`}>{isEnglish ? 'Privacy Policy' : 'Datenschutz'}</a>
		</nav>
	</div>
	{/* Lizenzzeile auf jeder Seite (CC BY-SA 4.0 verlangt Urheber, Lizenz, Quelle und den Hinweis
	    auf Bearbeitung). Ein Test (test_lizenzzeile.py) prüft, dass sie im Build überall steht. */}
	<p class="license-line" data-license-line>
		{isMethodik ? (
			isEnglish ? (
				<>Summary of BSI Standard 300-1, © BSI, <a href={BSI_TERMS}>BSI terms of use</a> apply · <a href="/en/ueber/#licenses">Licenses</a></>
			) : (
				<>Zusammenfassung des BSI-Standards 300-1, © BSI, es gelten die <a href={BSI_TERMS}>Nutzungsbedingungen des BSI</a> · <a href="/ueber/#lizenzen">Lizenzen</a></>
			)
		) : isEnglish ? (
			<>Catalog text © BSI-Bund, <a href={CC_BY_SA}>CC BY-SA 4.0</a> · <a href={BSI_CATALOG}>Source</a> · adapted by grundschutz-docs.de · <a href="/en/ueber/#licenses">Licenses and changes</a></>
		) : (
			<>Katalogtext © BSI-Bund, <a href={CC_BY_SA}>CC BY-SA 4.0</a> · <a href={BSI_CATALOG}>Quelle</a> · bearbeitet von grundschutz-docs.de · <a href="/ueber/#lizenzen">Lizenzen und Änderungen</a></>
		)}
	</p>
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}
		.footer-columns {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 2rem 1.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-hairline);
		}
		.footer-columns nav {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
			font-size: var(--sl-text-sm);
		}
		.license-line {
			margin: 0;
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
			line-height: 1.5;
		}
		.license-line a {
			color: inherit;
			text-underline-offset: 0.15em;
		}
		.license-line a:hover {
			color: var(--sl-color-accent);
		}
		.col-title {
			margin: 0 0 0.2rem;
			font-size: var(--sl-text-xs);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--sl-color-gray-2);
		}
		.footer-columns a {
			color: var(--sl-color-gray-3);
			text-decoration: none;
		}
		.footer-columns a:hover {
			color: var(--sl-color-accent);
		}
		/* Auf Seiten mit Seitenleiste ist der Footer nur etwa 650 px breit: vier Spalten waeren
		   140 px schmal ("Daten & Werkzeuge" und die Links brechen um, die Spalten laufen
		   auseinander). Dort zwei Spalten; die Startseite hat volle Breite und behaelt vier. */
		@media (max-width: 100rem) {
			:global([data-has-sidebar]) .footer-columns {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
		@media (max-width: 40rem) {
			.footer-columns {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
		/* Bei 320 px passt "DATEN & WERKZEUGE" sonst nicht in eine Zeile. */
		@media (max-width: 22rem) {
			.col-title {
				font-size: 0.65rem;
				letter-spacing: 0.02em;
			}
		}
	}
</style>
