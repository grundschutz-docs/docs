---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

<button type="button" class="sl-flex print-trigger" onclick="window.print()" aria-label="Diese Seite als PDF exportieren (Browser-Druckdialog)">
	<Icon name="download" />
</button>

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a {href} rel="me noopener noreferrer" target="_blank" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a,
		.print-trigger {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover,
		.print-trigger:hover {
			color: var(--sl-color-white);
		}
		.print-trigger {
			background: none;
			border: none;
			cursor: pointer;
		}
	}
</style>
