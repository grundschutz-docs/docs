---
import { Image } from 'astro:assets';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import CatalogPreview from './CatalogPreview.astro';
import LandingStats from './LandingStats.astro';

const PAGE_TITLE_ID = 'starlight__hero';

// Starlight reserviert ab 50rem eine zweite Hero-Spalte (7fr 4fr) für ein
// Bild. Wir haben keins — ohne Inhalt stand dort ein Drittel der Startseite
// leer. Statt eines Dekor-Bildes zeigt die Spalte den Vergleich "rohes OSCAL
// ↔ gelesene Anforderung", also genau die Behauptung der Tagline.
//
// Nur auf der Startseite: Impressum und Datenschutz nutzen zwar ebenfalls
// template: splash, haben aber gar keinen Hero — und ein künftiger Hero auf
// einer anderen Seite soll den Vergleich nicht ungefragt erben.
const isLandingPage = Astro.url.pathname === '/';

const { data } = Astro.locals.starlightRoute.entry;
const { siteTitle } = Astro.locals.starlightRoute;
// Fällt auf siteTitle (aus SITE_NAME in astro.config.mjs) zurück statt auf die
// Seiten-Frontmatter — so steuert eine einzige Stelle den sichtbaren Namen überall.
const { title = siteTitle, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	{!darkImage && !rawHtml && isLandingPage && <CatalogPreview />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
		{isLandingPage && <LandingStats />}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				/* 60/40 statt Starlights 7fr 4fr: die Vergleichskarte braucht
				   Breite, damit die JSON-Zeilen als Maschinenausgabe wirken
				   und nicht als Schnipsel. Nicht weiter — ab etwa 6fr 5fr
				   reicht die linke Spalte für "Grundschutz++ Docs" auch auf
				   breiten Fenstern nicht mehr und der Titel bricht um. */
				grid-template-columns: 3fr 2fr;
				gap: 3%;
				/* Starlights Standardwert reserviert viel Platz für ein Hero-Bild
				   (bis zu 10rem). Wir haben keins, also deutlich knapper. */
				padding-block: clamp(1.5rem, 4vmin, 3rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
