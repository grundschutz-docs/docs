---
/**
 * Umfangszahlen für die Startseite.
 *
 * Bewusst aus src/data/landing.json (Generator) statt von Hand: Zahlen auf
 * einer Startseite sind nur dann ein Glaubwürdigkeitsgewinn, wenn sie
 * nachprüfbar stimmen. Ändert das BSI den Katalog, ändern sie sich mit.
 *
 * Es sind zwei verschiedene Sorten Zahl, die vorher gleichrangig in einem
 * 2x2-Raster standen und sich dadurch als eine Liste lasen:
 *
 *   Umfang (1.000 Anforderungen, 20 Praktiken) beschreibt das PROBLEM -- wie
 *   groß das ist, womit man es zu tun hat. Das BSI veröffentlicht diese
 *   Zahlen selbst, sie unterscheiden diese Seite von nichts.
 *
 *   Abdeckung (1.185 Zuordnungen, 94 Bausteine) beschreibt die ARBEIT dieser
 *   Seite. Laut Fachpresse ist der meistgenannte Schmerzpunkt beim Umstieg
 *   nicht die Lesbarkeit, sondern dass es für die Migration keinen
 *   automatischen Knopf gibt -- hier steht die Antwort darauf.
 *
 * Deshalb tragen nur noch die beiden Abdeckungszahlen das große Format; der
 * Umfang steht als ein Satz darunter. Vorher stand das Alleinstellungsmerkmal
 * unten rechts, auf der schwächsten Position im Raster.
 */
import landing from '../data/landing.json';

const { stats } = landing;
const format = new Intl.NumberFormat('de-DE');

// "94 alte Bausteine abgedeckt" war keine Abdeckungsangabe, sondern eine Zahl
// ohne Bezug: abgedeckt von wie vielen? Ohne Nenner kann niemand einschätzen,
// ob das viel ist -- und das ist die erste Frage, die jemand stellt, der sich
// auf die Zuordnung verlassen will. Mit 111 daneben sind es 85 Prozent.
const coverage = [
	{ value: format.format(stats.mappings), label: 'Zuordnungen alt → neu' },
	{
		value: `${format.format(stats.bausteine)} von ${format.format(stats.bausteine_gesamt)}`,
		label: 'alten Bausteinen zugeordnet',
	},
];
---

<div class="landing-stats">
	<dl>
		{
			coverage.map((item) => (
				<div>
					<dt>{item.value}</dt>
					<dd>{item.label}</dd>
				</div>
			))
		}
	</dl>
	<p class="scope">
		Grundschutz++ umfasst {format.format(stats.controls)} Anforderungen in {
			format.format(stats.practices)
		} Praktiken.
	</p>
</div>

<style>
	.landing-stats {
		padding-top: 1.25rem;
		border-top: 1px solid var(--glass-border);
	}

	dl {
		display: grid;
		grid-template-columns: repeat(2, auto);
		gap: 1.5rem 2.5rem;
		margin: 0;
		justify-content: start;
	}

	dl div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	/*
	 * Display-Serife, nicht Monospace: "1.185" in JetBrains Mono liest sich wie
	 * Terminal-Ausgabe. Das sind redaktionelle Zahlen, eine Behauptung über
	 * geleistete Arbeit -- in Fraunces werden sie zu dem, was sie sind.
	 *
	 * Textfarbe statt Akzent: der Bernstein-Ton gehört Aktionen, dem aktuellen
	 * Ort und dem Fokusring (siehe die Akzent-Regel in custom.css).
	 */
	dt {
		font-family: 'Fraunces Variable', Georgia, serif;
		font-optical-sizing: auto;
		font-size: var(--sl-text-3xl);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-white);
		line-height: 1.1;
	}

	dd {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	/* Der Umfang bleibt sichtbar, tritt aber hinter die Abdeckung zurück --
	   ein Satz statt zwei weiterer großer Zahlen. */
	.scope {
		margin: 1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	@media (max-width: 50rem) {
		dl {
			justify-content: center;
			gap: 1.25rem 1.75rem;
		}

		dt {
			font-size: var(--sl-text-2xl);
		}

		.scope {
			text-align: center;
		}
	}
</style>
