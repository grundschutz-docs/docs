---
/**
 * Umfangszahlen für die Startseite.
 *
 * Bewusst aus src/data/landing.json (Generator) statt von Hand: Zahlen auf
 * einer Startseite sind nur dann ein Glaubwürdigkeitsgewinn, wenn sie
 * nachprüfbar stimmen. Ändert das BSI den Katalog, ändern sie sich mit.
 */
import landing from '../data/landing.json';

const { stats } = landing;
const format = new Intl.NumberFormat('de-DE');

const items = [
	{ value: stats.controls, label: 'Anforderungen' },
	{ value: stats.practices, label: 'Praktiken' },
	{ value: stats.bausteine, label: 'Alte Bausteine zugeordnet' },
	{ value: stats.mappings, label: 'Zuordnungen alt → neu' },
];
---

<dl class="landing-stats">
	{
		items.map((item) => (
			<div>
				<dt>{format.format(item.value)}</dt>
				<dd>{item.label}</dd>
			</div>
		))
	}
</dl>

<style>
	.landing-stats {
		display: grid;
		grid-template-columns: repeat(2, auto);
		gap: 1.5rem 2.5rem;
		margin: 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--glass-border);
	}

	.landing-stats div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	dt {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-2xl);
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-accent-high);
		line-height: 1.1;
	}

	dd {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	@media (max-width: 50rem) {
		.landing-stats {
			justify-content: center;
			gap: 1.25rem 1.75rem;
		}

		dt {
			font-size: var(--sl-text-xl);
		}
	}
</style>
