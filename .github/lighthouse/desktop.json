{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/grundschutzpp/konf/index.html",
        "http://localhost/zielobjekte/webserver/index.html",
        "http://localhost/dokumente/datensicherungskonzept/index.html",
        "http://localhost/export/index.html",
        "http://localhost/rollen/isb/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report/desktop"
    }
  }
}
