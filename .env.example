# Kopieren nach .env und anpassen. .env ist gitignoriert — echte
# Betreiberdaten landen dadurch nie im Repository, auch nicht in einem Fork.
# Alternativ lassen sich alle Werte als echte Umgebungsvariablen setzen
# (Hosting-Panel, CI); die gewinnen gegen die Datei.

# Steuert Header-Titel, Browser-Tab und die Hero-Überschrift auf der Startseite.
SITE_NAME=Grundschutz++ Docs

# Produktionsadresse dieser Instanz. Steuert sitemap.xml, Canonical- und
# OG-URLs. Nur setzen, wenn du die Seite selbst unter einer anderen Domain
# betreibst — sonst gilt der Standard aus astro.config.mjs.
# SITE_URL=https://beispiel.de

# --- Betreiberangaben für Impressum und Datenschutzerklärung -----------------
# Solange NAME, ADDRESS und EMAIL nicht alle gesetzt sind, zeigen beide Seiten
# Platzhalter plus einen sichtbaren "noch nicht konfiguriert"-Hinweis. Wer die
# Seite öffentlich betreibt, braucht nach § 5 DDG ein eigenes Impressum mit den
# eigenen Angaben.

OPERATOR_NAME=
# Mehrzeilige Anschrift mit | trennen, z. B.:
# OPERATOR_ADDRESS=c/o Musterfirma|Musterstraße 1|12345 Musterstadt
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Hosting-Anbieter und Serverstandort (Abschnitt 2 der Datenschutzerklärung).
# OPERATOR_HOSTING=Gehostet bei der Hetzner Online GmbH, Serverstandort Deutschland.
OPERATOR_HOSTING=

# Nur setzen, wenn du Cookies oder Tracking einsetzt. Leer gelassen steht in
# der Erklärung, dass weder Cookies noch Tracking verwendet werden — was für
# den ausgelieferten Stand dieses Repos zutrifft (statische Seiten, Suche
# läuft per Pagefind im Browser).
OPERATOR_TRACKING=

# Für dich zuständige Landesdatenschutzbehörde (richtet sich nach deinem Sitz).
# OPERATOR_AUTHORITY=Der Hessische Beauftragte für Datenschutz und Informationsfreiheit, Postfach 3163, 65021 Wiesbaden.
OPERATOR_AUTHORITY=
